# DARZFUSION AI Environment Configuration
# Copy this file to .env and provide your actual API keys and secrets

# Application Settings
ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security (Generate a strong random string in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (default development): sqlite:///./darzfusion.db
# PostgreSQL (production): postgresql://user:password@hostname:5432/darzfusion
DATABASE_URL=sqlite:///./darzfusion.db

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Vector Store and Storage Paths
CHROMA_PERSIST_DIRECTORY=./chroma_db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# Web Search Provider Configuration
# Options: 'duckduckgo' (no key required), 'tavily', 'serpapi'
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=

# CORS Settings (Comma-separated origins, or * for all)
CORS_ORIGINS=*
